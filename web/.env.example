# Copy to .env and fill in as needed. Read by Vite at build/dev-server time
# (import.meta.env.VITE_*) — a change here requires restarting `npm run dev`.

# Base URL the frontend calls for every API request. Defaults to
# http://127.0.0.1:8080/api/v1 (matches cmd/api's default API_ADDR) when unset
# — only override for a non-default backend address.
VITE_API_BASE=

# Must match the backend's GOOGLE_CLIENT_ID (see ../.env.example) exactly —
# this is what makes the Google Identity Services button render at all.
# Leave blank to keep Google sign-in hidden.
VITE_GOOGLE_CLIENT_ID=
