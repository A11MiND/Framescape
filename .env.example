# Copy to .env and fill in the values marked REQUIRED. .env is gitignored —
# never commit real secrets here. Read by internal/pkg/config/config.go
# (one getEnv() call per line below); docker-compose (deploy/docker-compose.yml)
# loads this same file via env_file for cmd/api, cmd/scheduler, and cmd/worker.
# `go run ./cmd/...` does NOT auto-load .env — export these in your shell first
# (e.g. `set -a && source .env && set +a`) before running a service locally.

# --- Core (has a working local-dev default, override for anything else) ---

# MySQL DSN. The default matches deploy/docker-compose.yml's mysql service
# exactly (root/root, database `aigc`) — only override for a non-Docker MySQL.
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/aigc?parseTime=true&loc=UTC&charset=utf8mb4

# REQUIRED outside local dev. deploy/docker-compose.yml reads this directly
# to set the mysql container's root password (and build every service's
# MYSQL_DSN) — it refuses to start without it. Generate one with:
# openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

REDIS_ADDR=127.0.0.1:6379

# "dev" or "prod" — controls logger formatting (internal/pkg/logger) and, as
# of the JWT_SECRET fail-fast check below, whether the process will refuse
# to start with an insecure default secret. Set to "prod" for any real
# deployment.
APP_ENV=dev

# REQUIRED outside local dev. Signs every access/refresh JWT — anyone who
# knows this value can forge a valid session for any user. Falls back to a
# literal hardcoded in config.go for zero-config local dev only; the process
# refuses to start with that fallback still in place once APP_ENV=prod.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- MinIO / object storage (PRD F2.2/R3) ---
# Defaults match deploy/docker-compose.yml's minio service. In Docker,
# these two also double as the minio container's own root user/password
# (not just the Go client's credentials) — one pair, one source of truth.

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=aigc-assets
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/aigc-assets

# Externally-reachable origin for the whole stack, fronted by the `web`
# (nginx) service in deploy/docker-compose.yml — used to build
# MINIO_PUBLIC_BASE_URL for scheduler/worker so asset links resolve through
# nginx instead of hitting minio directly. A bare `http://localhost` (or the
# server's IP) is fine behind a temporary Cloudflare quick tunnel; switch to
# `https://your-domain` once there's a real domain in front.
PUBLIC_BASE_URL=http://localhost

# --- MiniMax (PRD §3) ---

# REQUIRED for any real generation — every job type (image/video/prompt
# rewrite/story split) calls out to MiniMax. Without this, cmd/worker can
# still run entirely on the mock.* executors (see PRD §10.1) for dev/testing.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com

# Public URL MiniMax should POST video status pushes to. Empty is fine on a
# dev machine behind NAT — minimax.video falls back to polling-only (§11.3).
MINIMAX_CALLBACK_URL=
# Shared secret checked against the callback's ?token= query param. Empty
# disables the check — fine for local dev, MUST be set before
# MINIMAX_CALLBACK_URL is ever a publicly reachable address.
MINIMAX_CALLBACK_TOKEN=
# This account's granted MiniMax video concurrency quota — MiniMax doesn't
# expose this via API, so it's manually configured. 0 = unbounded, fine for
# a dev account making one call at a time; set to the real granted quota
# before any concurrent load.
MINIMAX_VIDEO_CONCURRENCY=0

# --- Gemini / Vertex AI (image.comic4's optional second image-generation
# provider, chosen per-job via Spec.ImageProvider="gemini"; default is still
# MiniMax) ---

# GCP project ID Vertex AI calls bill against. Empty (the default) disables
# Gemini registration entirely in cmd/worker.
GEMINI_VERTEX_PROJECT_ID=
GEMINI_VERTEX_LOCATION=us-central1
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Caps concurrent Vertex AI generateContent calls. 0 = unbounded. comic4's
# anchor-mode DAG deliberately fires every panel's generation in parallel,
# which reliably trips a fresh GCP project's default per-project quota
# (429 RESOURCE_EXHAUSTED) — set this to a conservative number (1-2) until
# this project's real granted quota is confirmed higher.
GEMINI_VERTEX_CONCURRENCY=0
# Paces requests over time (no new call starts until this many ms have
# passed since the last one started) — this is the gate that actually
# matters against Vertex AI Express Mode's low, no-billing trial quota,
# which is a requests-per-time-window limit, not a concurrent-connections
# one. 0 disables it. Tune down once this project's real granted quota is
# confirmed higher (e.g. after enabling billing / requesting a quota bump).
GEMINI_VERTEX_MIN_INTERVAL_MS=0
# Authentication: two supported paths.
#
# 1) File path (local dev, GCE/Cloud Run) — NOT a var this app's own config
# code reads; the Vertex AI Go SDK authenticates via Application Default
# Credentials, so set the SDK's own standard env var to a service-account key
# file's path (never paste the key's contents here):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Docker Compose (deploy/docker-compose.yml) local dev only: GOOGLE_APPLICATION_CREDENTIALS
# above must be a path *inside* the worker container, not the host — set it
# to /run/secrets/gemini-credentials.json (the compose file's own mount
# target) and point this at the real key file's path on your host machine:
# GEMINI_VERTEX_CREDENTIALS_HOST_PATH=/absolute/path/to/service-account.json
#
# 2) Raw JSON content (Railway, or any target with no file that survives a
# redeploy) — paste the service-account key file's whole JSON content as this
# variable's value. This app's own config code never logs it; only ever hands
# the bytes straight to the Google auth library.
GEMINI_VERTEX_CREDENTIALS_JSON=

# --- Google / phone / email login scaffolding ---
# Every one of these is a real optional feature gate, not a placeholder:
# routes, DB columns, and frontend entry points exist regardless, and each
# one answers a real 4xx ("not configured") until its key is set here. Leave
# blank to keep the corresponding sign-in method disabled.

# OAuth 2.0 web client ID from Google Cloud Console (APIs & Services →
# Credentials) — NOT the API key. Also needs VITE_GOOGLE_CLIENT_ID set to
# the same value in web/.env for the frontend button to render.
GOOGLE_CLIENT_ID=
# No SMS provider is wired into sendSMSCode yet (see auth_oauth.go) —
# setting this alone is not enough to make phone login work end to end.
SMS_API_KEY=
# Same story as SMS_API_KEY — no email provider is wired into sendEmailCode
# yet.
EMAIL_PROVIDER_API_KEY=

# --- Process addresses (rarely need overriding outside Docker) ---

WORKER_CONCURRENCY=8
API_ADDR=:8080
SCHEDULER_ADDR=:8090
SCHEDULER_URL=http://127.0.0.1:8090

# Overrides upkeep.SuspendedTimeout's 7-day default, in seconds. 0 or unset
# means "use the default" — only set this to test the cleanup path without
# waiting 7 real days.
SUSPENDED_TIMEOUT_SECONDS=0
