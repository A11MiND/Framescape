# Split out of the old shared deploy/Dockerfile's `worker` target — see
# Dockerfile.api's own doc for why the build stage is duplicated per file
# rather than shared. Unlike the other three, this one still needs
# ffmpeg/ffprobe (internal/infra/executor/local shells out to them) — don't
# drop that apk line when editing this file.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates ffmpeg
COPY --from=build /out/worker /usr/local/bin/worker
ENTRYPOINT ["/usr/local/bin/worker"]
