{
  "apiVersion": "aether/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "image-single-gemini",
    "annotations": {
      "description": "image.single's Gemini/Vertex AI counterpart (Spec.ImageProvider=\"gemini\") — same 1-task shape as image-single.json, routed to gemini.image instead of minimax.image. reference-image-asset-ids (plural, unlike minimax's single source-image-asset-id) exists specifically to exercise Gemini's own multi-image-fusion recipe for a scene needing more than one bound character at once, which MiniMax's subject_reference (exactly one reference image per call) can never do."
    }
  },
  "spec": {
    "entrypoint": "main",
    "arguments": {
      "parameters": [
        { "name": "prompt", "type": "string" },
        { "name": "seed", "type": "string" },
        { "name": "reference-image-asset-ids", "type": "array" },
        { "name": "user-id", "type": "string" },
        { "name": "n", "type": "string", "default": "1" },
        { "name": "aspect-ratio", "type": "string", "default": "" }
      ]
    },
    "templates": [
      {
        "dag": {
          "name": "main",
          "tasks": [
            {
              "name": "gen",
              "template": "gen-image-gemini",
              "arguments": {
                "parameters": [
                  { "name": "prompt", "valueFrom": { "parameter": "workflow.parameters.prompt" } },
                  { "name": "seed", "valueFrom": { "parameter": "workflow.parameters.seed" } },
                  { "name": "reference-image-asset-ids", "valueFrom": { "parameter": "workflow.parameters.reference-image-asset-ids" } },
                  { "name": "user-id", "valueFrom": { "parameter": "workflow.parameters.user-id" } },
                  { "name": "n", "valueFrom": { "parameter": "workflow.parameters.n" } },
                  { "name": "aspect-ratio", "valueFrom": { "parameter": "workflow.parameters.aspect-ratio" } }
                ]
              }
            }
          ]
        }
      },
      {
        "task": {
          "name": "gen-image-gemini",
          "executor": { "type": "gemini.image" },
          "inputs": {
            "parameters": [
              { "name": "prompt", "type": "string" },
              { "name": "seed", "type": "string" },
              { "name": "reference-image-asset-ids", "type": "array" },
              { "name": "user-id", "type": "string" },
              { "name": "n", "type": "string" },
              { "name": "aspect-ratio", "type": "string", "value": "" }
            ]
          },
          "phaseConditions": {
            "succeeded": "outputs.parameters[\"success-count\"] == outputs.parameters[\"requested-n\"]",
            "failed": "outputs.parameters[\"success-count\"] < outputs.parameters[\"requested-n\"]"
          },
          "retry": { "limit": 2 },
          "timeout": "3m"
        }
      }
    ]
  }
}
