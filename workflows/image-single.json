{
  "apiVersion": "aether/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "image-single",
    "annotations": {
      "description": "F5.1/F5.2 单图与批量出图已合并: 1 个 Task, n=1..9 (单次 MiniMax 调用出 1..9 张，n=1 时就是原本的单图), 不是 N 个并行 Task — 见 PRD §4.2 划分原则。image.batch 作为独立 workflow_name 已撤除，n 现在是 image.single 自己的可选参数。"
    }
  },
  "spec": {
    "entrypoint": "main",
    "arguments": {
      "parameters": [
        { "name": "prompt", "type": "string" },
        { "name": "seed", "type": "string" },
        { "name": "source-image-asset-id", "type": "string" },
        { "name": "user-id", "type": "string" },
        { "name": "n", "type": "string", "default": "1" }
      ]
    },
    "templates": [
      {
        "dag": {
          "name": "main",
          "tasks": [
            {
              "name": "gen",
              "template": "gen-image",
              "arguments": {
                "parameters": [
                  { "name": "prompt", "valueFrom": { "parameter": "workflow.parameters.prompt" } },
                  { "name": "seed", "valueFrom": { "parameter": "workflow.parameters.seed" } },
                  { "name": "source-image-asset-id", "valueFrom": { "parameter": "workflow.parameters.source-image-asset-id" } },
                  { "name": "user-id", "valueFrom": { "parameter": "workflow.parameters.user-id" } },
                  { "name": "n", "valueFrom": { "parameter": "workflow.parameters.n" } }
                ]
              }
            }
          ]
        }
      },
      {
        "task": {
          "name": "gen-image",
          "executor": { "type": "minimax.image" },
          "inputs": {
            "parameters": [
              { "name": "prompt", "type": "string" },
              { "name": "seed", "type": "string" },
              { "name": "source-image-asset-id", "type": "string" },
              { "name": "user-id", "type": "string" },
              { "name": "n", "type": "string" }
            ]
          },
          "phaseConditions": {
            "succeeded": "outputs.parameters[\"success-count\"] == outputs.parameters[\"requested-n\"]",
            "failed": "outputs.parameters[\"success-count\"] < outputs.parameters[\"requested-n\"]"
          },
          "retry": { "limit": 2 },
          "timeout": "3m"
        }
      }
    ]
  }
}
