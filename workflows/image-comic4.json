{
  "apiVersion": "aether/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "image-comic4",
    "annotations": {
      "description": "F5.3 四格漫画: 4 格独立并行生成 (Loop, 互相无依赖 — 与 video.sequence 不同, 见 docs/aether-validation-report.md §四), 完成后自动拼版 2x2。panels 是对象数组 [{prompt,user-id}, ...] 不是裸字符串数组: loop.arguments 里的 {{...}} 插值实测不生效 (docs/aether-validation-report.md §四 W4 补记), 唯一可靠的传值方式是 item 本身是对象, 字段自动成为循环体任务的同名输入。"
    }
  },
  "spec": {
    "entrypoint": "main",
    "arguments": {
      "parameters": [
        { "name": "panels", "type": "array" },
        { "name": "user-id", "type": "string" }
      ]
    },
    "templates": [
      {
        "dag": {
          "name": "main",
          "tasks": [
            {
              "name": "panels",
              "template": "panel-loop",
              "arguments": {
                "parameters": [
                  { "name": "panel-list", "valueFrom": { "parameter": "workflow.parameters.panels" } }
                ]
              }
            },
            {
              "name": "compose",
              "template": "compose-grid",
              "dependencies": ["panels"],
              "arguments": {
                "parameters": [
                  { "name": "asset-ids", "valueFrom": { "parameter": "tasks.panels.outputs.parameters.asset-id" } },
                  { "name": "user-id", "valueFrom": { "parameter": "workflow.parameters.user-id" } }
                ]
              }
            }
          ]
        }
      },
      {
        "loop": {
          "name": "panel-loop",
          "inputs": {
            "parameters": [
              { "name": "panel-list", "type": "array" }
            ]
          },
          "itemsFrom": "{{inputs.parameters.panel-list}}",
          "body": "gen-one-panel",
          "aggregate": {
            "strategy": "list",
            "parameters": ["asset-id"]
          },
          "outputs": {
            "parameters": [
              { "name": "asset-id", "type": "array" }
            ]
          }
        }
      },
      {
        "task": {
          "name": "gen-one-panel",
          "executor": { "type": "minimax.image" },
          "inputs": {
            "parameters": [
              { "name": "prompt", "type": "string" },
              { "name": "seed", "type": "string" },
              { "name": "source-image-asset-id", "type": "string" },
              { "name": "user-id", "type": "string" },
              { "name": "n", "type": "string", "value": "1" }
            ]
          },
          "phaseConditions": {
            "succeeded": "outputs.parameters[\"success-count\"] == outputs.parameters[\"requested-n\"]",
            "failed": "outputs.parameters[\"success-count\"] < outputs.parameters[\"requested-n\"]"
          },
          "retry": { "limit": 2 },
          "timeout": "3m"
        }
      },
      {
        "task": {
          "name": "compose-grid",
          "executor": { "type": "local.compose" },
          "inputs": {
            "parameters": [
              { "name": "asset-ids", "type": "array" },
              { "name": "user-id", "type": "string" },
              { "name": "layout", "type": "string", "value": "2x2" }
            ]
          },
          "timeout": "1m"
        }
      }
    ]
  }
}
