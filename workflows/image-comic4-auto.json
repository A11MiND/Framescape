{
  "apiVersion": "aether/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "image-comic4-auto",
    "annotations": {
      "description": "F5.4 opt-in variant of image-comic4: adds a `split` node (minimax.text.split_story, MiniMax-M3) before the panel loop, turning one story description into the same [{prompt,user-id}, ...] object-array shape jobsvc.go builds by hand for the manual-4-panels path — required because loop.arguments {{...}} interpolation doesn't resolve values pulled from another task's outputs inside a loop body (docs/aether-validation-report.md §四 W4 addendum), so the item objects have to already carry user-id themselves. Kept as its own workflow file rather than a conditional `when` node, same reasoning as video-single-enhanced.json."
    }
  },
  "spec": {
    "entrypoint": "main",
    "arguments": {
      "parameters": [
        { "name": "story", "type": "string" },
        { "name": "user-id", "type": "string" }
      ]
    },
    "templates": [
      {
        "dag": {
          "name": "main",
          "tasks": [
            {
              "name": "split",
              "template": "split-story",
              "arguments": {
                "parameters": [
                  { "name": "story", "valueFrom": { "parameter": "workflow.parameters.story" } },
                  { "name": "user-id", "valueFrom": { "parameter": "workflow.parameters.user-id" } }
                ]
              }
            },
            {
              "name": "panels",
              "template": "panel-loop",
              "dependencies": ["split"],
              "arguments": {
                "parameters": [
                  { "name": "panel-list", "valueFrom": { "parameter": "tasks.split.outputs.parameters.panels" } }
                ]
              }
            },
            {
              "name": "compose",
              "template": "compose-grid",
              "dependencies": ["panels"],
              "arguments": {
                "parameters": [
                  { "name": "asset-ids", "valueFrom": { "parameter": "tasks.panels.outputs.parameters.asset-id" } },
                  { "name": "user-id", "valueFrom": { "parameter": "workflow.parameters.user-id" } }
                ]
              }
            }
          ]
        }
      },
      {
        "task": {
          "name": "split-story",
          "executor": { "type": "minimax.text.split_story" },
          "inputs": {
            "parameters": [
              { "name": "story", "type": "string" },
              { "name": "user-id", "type": "string" }
            ]
          },
          "retry": { "limit": 1 },
          "timeout": "2m"
        }
      },
      {
        "loop": {
          "name": "panel-loop",
          "inputs": {
            "parameters": [
              { "name": "panel-list", "type": "array" }
            ]
          },
          "itemsFrom": "{{inputs.parameters.panel-list}}",
          "body": "gen-one-panel",
          "aggregate": {
            "strategy": "list",
            "parameters": ["asset-id"]
          },
          "outputs": {
            "parameters": [
              { "name": "asset-id", "type": "array" }
            ]
          }
        }
      },
      {
        "task": {
          "name": "gen-one-panel",
          "executor": { "type": "minimax.image" },
          "inputs": {
            "parameters": [
              { "name": "prompt", "type": "string" },
              { "name": "user-id", "type": "string" },
              { "name": "n", "type": "string", "value": "1" }
            ]
          },
          "phaseConditions": {
            "succeeded": "outputs.parameters[\"success-count\"] == outputs.parameters[\"requested-n\"]",
            "failed": "outputs.parameters[\"success-count\"] < outputs.parameters[\"requested-n\"]"
          },
          "retry": { "limit": 2 },
          "timeout": "3m"
        }
      },
      {
        "task": {
          "name": "compose-grid",
          "executor": { "type": "local.compose" },
          "inputs": {
            "parameters": [
              { "name": "asset-ids", "type": "array" },
              { "name": "user-id", "type": "string" },
              { "name": "layout", "type": "string", "value": "2x2" }
            ]
          },
          "timeout": "1m"
        }
      }
    ]
  }
}
